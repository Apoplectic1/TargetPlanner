<?xml version="1.0" encoding="utf-8"?>
<configuration>
    <startup>
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8.1"/>
    </startup>
    <runtime>
        <!-- Server GC: per-logical-core heap partitions collected in parallel instead of the
             single-threaded Workstation GC default. Decisive for this app because the
             multi-target build path (AltitudeSeries.ComputeYearCache, 365 CoordinateSharp
             ComputeNight calls per target) is extremely allocation-heavy; Workstation GC's
             single-threaded collections pause every worker and serialize what should be
             embarrassingly-parallel CPU work. -->
        <gcServer enabled="true"/>
        <!-- Background / concurrent collection of Gen 2 so full collections don't freeze the
             UI thread for long pauses. Layered on top of Server GC. -->
        <gcConcurrent enabled="true"/>
    </runtime>
</configuration>

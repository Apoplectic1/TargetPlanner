<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net481</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>TargetPlanner</RootNamespace>
    <AssemblyName>TargetPlanner</AssemblyName>
    <LangVersion>7.3</LangVersion>
    <StartupObject>TargetPlanner.Program</StartupObject>
    <Deterministic>true</Deterministic>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <!-- Keep the existing Properties/AssemblyInfo.cs as the source of truth for assembly
         attributes; without this flag the SDK auto-generates a competing AssemblyInfo and the
         build fails with duplicate-attribute errors. -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <Platforms>AnyCPU;x64</Platforms>
  </PropertyGroup>

  <!-- NuGet packages (formerly packages.config). Versions preserved exactly. -->
  <ItemGroup>
    <PackageReference Include="CoordinateSharp" Version="3.4.1.1" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4"  />
  </ItemGroup>

  <!-- Non-NuGet references. LocalLib is a private sibling assembly; DataVisualization is a
       .NET Framework GAC assembly not rolled into UseWindowsForms. -->
  <ItemGroup>
    <Reference Include="LocalLib">
      <HintPath>..\..\..\Libraries\LocalLib\LocalLib\bin\Release\LocalLib.dll</HintPath>
    </Reference>
    <Reference Include="System.Windows.Forms.DataVisualization" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Library\Astronomy.Core\Astronomy.Core.csproj" />
  </ItemGroup>

  <!-- Preserve generator metadata so VS regenerates Resources.Designer.cs / Settings.Designer.cs
       when the corresponding .resx / .settings is edited. Using Update= (not Include=) because
       the SDK's default globs already included these files; we're only augmenting metadata. -->
  <ItemGroup>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
      <SubType>Designer</SubType>
    </EmbeddedResource>
    <None Update="Properties\Settings.settings">
      <Generator>SettingsSingleFileGenerator</Generator>
      <LastGenOutput>Settings.Designer.cs</LastGenOutput>
    </None>
  </ItemGroup>

</Project>

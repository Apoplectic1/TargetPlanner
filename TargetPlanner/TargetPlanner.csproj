<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- net10.0-windows10.0.19041 (Win10 2004 / 20H1, May 2020) is required because
         SkiaSharp.Views.WindowsForms 3.119.0, pulled transitively via
         LiveChartsCore.SkiaSharpView.WinForms, only ships modern-.NET assets at the
         net8.0-windows10.0.19041 TFM. The default net10.0-windows (which resolves to
         net10.0-windows7.0) would fall all the way back to that package's net462 lib,
         which doesn't load on .NET 10. Win10 2004 is well past EOL of anything older;
         safe floor. -->
    <TargetFramework>net10.0-windows10.0.19041</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>TargetPlanner</RootNamespace>
    <AssemblyName>TargetPlanner</AssemblyName>
    <LangVersion>latest</LangVersion>
    <StartupObject>TargetPlanner.Program</StartupObject>
    <Deterministic>true</Deterministic>
    <!-- GC tuning migrated from App.config <runtime> when TP moved to net10.
         Modern .NET emits these to runtimeconfig.json automatically and ignores
         App.config <gcServer>/<gcConcurrent>. Server GC = per-logical-core heaps
         collected in parallel (decisive for the multi-target prepare path,
         which allocates heavily); concurrent GC = background Gen 2 collection
         so full collections don't pause the UI thread. -->
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <!-- The SDK auto-generates AssemblyTitle / Product / Version / etc. from the metadata
         properties below. Properties/AssemblyInfo.cs is kept only for [ComVisible] and [Guid]
         (attributes the SDK does NOT auto-generate); its version attributes were removed when
         MinVer + Velopack were wired in. Per-attribute Generate*=false toggles let us keep
         AssemblyInfo.cs's two remaining attributes without the duplicate-attribute build error. -->
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <GenerateAssemblyComVisibleAttribute>false</GenerateAssemblyComVisibleAttribute>
    <GenerateAssemblyGuidAttribute>false</GenerateAssemblyGuidAttribute>
    <Platforms>x64</Platforms>
    <!-- Compile-time assertion that no TP code uses unsafe blocks. The default is
         already false; making it explicit means a future ProjectReference to
         Astronomy.PCL (which wraps native PCL pointers) cannot leak `unsafe`
         constructs into the WinForms host without flipping this flag deliberately.
         All P/Invoke / native-marshalling code lives in TargetPlanner/Imaging/
         and exposes only managed DTOs upward; see Imaging/README.md. -->
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <!-- Assembly metadata previously in Properties/AssemblyInfo.cs. Version is omitted so
         MinVer can stamp it from the latest git tag (e.g. v1.0.0 yields assembly 1.0.0). -->
    <AssemblyTitle>TargetPlanner</AssemblyTitle>
    <Product>TargetPlanner</Product>
    <Copyright>Copyright © 2026</Copyright>
    <!-- MinVer derives version from the latest git tag. Tag prefix `v` matches the release
         convention `vX.Y.Z`. Untagged commits past a tag get an alpha.0.N prerelease shape so
         dev builds don't masquerade as a release. -->
    <MinVerTagPrefix>v</MinVerTagPrefix>
    <MinVerDefaultPreReleaseIdentifiers>alpha.0</MinVerDefaultPreReleaseIdentifiers>
  </PropertyGroup>

  <!-- NuGet packages (formerly packages.config). Versions preserved exactly. -->
  <ItemGroup>
    <PackageReference Include="MinVer" Version="7.0.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="LiveChartsCore.SkiaSharpView.WinForms" Version="2.1.0-dev-365" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="Velopack" Version="0.0.1298" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Library\Astronomy.Core\Astronomy.Core.csproj" />
    <ProjectReference Include="..\..\Library\Astronomy.NINA\Astronomy.NINA.csproj" />
  </ItemGroup>

  <!-- Preserve generator metadata so VS regenerates Resources.Designer.cs / Settings.Designer.cs
       when the corresponding .resx / .settings is edited. Using Update= (not Include=) because
       the SDK's default globs already included these files; we're only augmenting metadata. -->
  <ItemGroup>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
      <SubType>Designer</SubType>
    </EmbeddedResource>
    <None Update="Properties\Settings.settings">
      <Generator>SettingsSingleFileGenerator</Generator>
      <LastGenOutput>Settings.Designer.cs</LastGenOutput>
    </None>
  </ItemGroup>

</Project>
